# Pflicht. Mindestens 32 Zeichen, z. B. mit `openssl rand -base64 32` erzeugen
AUTH_SECRET=

# Öffentliche Adresse der App, ohne Schrägstrich am Ende
APP_URL=http://localhost:3000

# Speicherorte
DATABASE_PATH=./data/pantry.db
UPLOAD_DIR=./data/uploads

# Optional. Nur für die Ersteinrichtung. Wenn gesetzt, muss dieser Code beim Anlegen des ersten Kontos eingegeben werden
SETUP_TOKEN=

# Optional. Für Push-Benachrichtigungen zu ablaufenden Lebensmitteln (`npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional. debug, info, warn oder error
LOG_LEVEL=info
