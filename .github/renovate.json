{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch"], "matchDepTypes": ["devDependencies"], "automerge": true },
    {
      "matchPackageNames": ["next", "react", "react-dom", "eslint-config-next"],
      "groupName": "Next.js und React"
    }
  ]
}
